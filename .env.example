# 複製成 .env 後填值。.env 已在 .gitignore 裡，不會進版控。

# 手機（加到主畫面）與遠端連線必填。用 `stockcapy token --write-env` 產生（Docker 見 README「快速開始」）。
# 沒設這個時，serve 只允許綁 127.0.0.1（fail closed）。
PORTFOLIO_API_TOKEN=

# Telegram 推播（兩個都要填才會啟用）
# bot token：跟 @BotFather 對話 /newbot 取得
# chat id：跟你的 bot 說一句話，然後開
#   https://api.telegram.org/bot<TOKEN>/getUpdates 看 result[0].message.chat.id
PORTFOLIO_TELEGRAM_BOT_TOKEN=
PORTFOLIO_TELEGRAM_CHAT_ID=

# Email 推播（另一條通知管道，與 Telegram 並行；host + sender + recipient 三個
# 都填才會啟用）。密碼放這裡，不要寫進程式（見 decisions.md D13）。
# PORTFOLIO_SMTP_HOST=smtp.gmail.com
# PORTFOLIO_SMTP_PORT=587
# PORTFOLIO_SMTP_USERNAME=you@gmail.com
# PORTFOLIO_SMTP_PASSWORD=應用程式專用密碼
# PORTFOLIO_EMAIL_SENDER=you@gmail.com
# PORTFOLIO_EMAIL_RECIPIENT=you@gmail.com
# PORTFOLIO_SMTP_USE_TLS=1

# 智慧提醒：判斷「大盤同向」用的基準指數（預設 SPY），與抓多少天歷史算指標
# （預設 400 天，需 ≥ 200 個交易日才算得出 200 日均線）
# PORTFOLIO_BENCHMARK_SYMBOL=SPY
# PORTFOLIO_SIGNAL_LOOKBACK_DAYS=400

# 智慧提醒：大盤系統性下跌時，把被大盤帶動的訊號靜音（仍會列出，但不推播）
# PORTFOLIO_MUTE_MARKET_WIDE=1

# 智慧提醒：同樣的條件持續觸發時，什麼時候再通知一次。條件有變一定會通知；
# 沒變的話，價格比上次通知再往同方向走 N%（預設 5），或距上次通知滿 N 天（預設 7）才再發。
# PORTFOLIO_SIGNAL_RENOTIFY_MOVE_PERCENT=5
# PORTFOLIO_SIGNAL_REMINDER_DAYS=7

# 智慧提醒的訊息格式：compact（一行）、plain（白話，預設）、full（含門檻與資料時間）
# 可對 Telegram / Email 個別指定；macOS 桌面通知固定用 compact。
# PORTFOLIO_MESSAGE_STYLE=plain
# PORTFOLIO_TELEGRAM_MESSAGE_STYLE=compact
# PORTFOLIO_EMAIL_MESSAGE_STYLE=full
# 設 0 隱藏持倉均價與損益（例如通知會轉到群組時）
# PORTFOLIO_MESSAGE_SHOW_HOLDINGS=1

# 智慧提醒（可選）第二層：用 LLM 把觸發的規則講得更自然。預設關。
# 開啟需先安裝 llm extra（uv pip install -e ".[llm]"）並設好 ANTHROPIC_API_KEY。
# 只把「已觸發的事實」交給模型，禁止它新增判斷，輸出一律附免責，失敗自動回退樣板。
# PORTFOLIO_LLM_NARRATION=1
# PORTFOLIO_LLM_MODEL=claude-opus-5

# 雲端用：容器裡沒有 macOS 通知，關掉避免每次都失敗
# PORTFOLIO_DESKTOP_NOTIFICATIONS=0

# 雲端用：app 內建排程的間隔（分鐘）。0 或不設 = 不背景檢查（本機用 launchd）
# 排程會同時跑「到價提醒」與「智慧提醒」兩種檢查
# PORTFOLIO_CHECK_INTERVAL_MINUTES=30

# 資料庫位置（雲端要指到掛載的 volume）
# PORTFOLIO_DATA_DIR=/data

PORTFOLIO_NRA_WITHHOLDING=0.30
PORTFOLIO_HOME_CURRENCY=TWD
